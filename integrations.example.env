# ~/.config/blynx-clips/integrations.env (mode 0600)
# Register a Public client in https://dev.twitch.tv/console/apps.
BLYNX_TWITCH_CLIENT_ID=
# Use Settings > Authorize to store Twitch tokens in your OS credential store.
# Optional only for manually supplied user tokens scoped to user:read:chat.
# BLYNX_TWITCH_TOKEN=
# Restrict the Google Cloud key to YouTube Data API v3.
BLYNX_YOUTUBE_API_KEY=

