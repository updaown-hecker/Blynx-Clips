# Add or remove channels in the dashboard by default.
# Uncomment only to pin monitoring to one channel via the environment.
# BLYNX_FOLLOW_URL=https://www.twitch.tv/theirname
# Set to 1 to reclaim storage from older, unreviewed automatic highlights.
BLYNX_SERVER_PRUNE=0

# Optional HTTPS dashboard route through a tunnel on this server.
# Generate the password with: openssl rand -hex 32
# BLYNX_PUBLIC_ORIGIN=https://clips.blynx.vip
# BLYNX_WEB_PASSWORD=YOUR_GENERATED_PASSWORD

# Optional direct HTTP access on your trusted home network.
# Use a separate password generated with: openssl rand -hex 32
# BLYNX_LAN_IP=0.0.0.0
# BLYNX_LAN_PASSWORD=YOUR_SEPARATE_GENERATED_PASSWORD
