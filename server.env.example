# Use a channel page so the recorder follows future streams.
BLYNX_FOLLOW_URL=https://www.twitch.tv/REPLACE_WITH_CHANNEL
# Set to 1 to reclaim storage from older, unreviewed automatic highlights.
BLYNX_SERVER_PRUNE=0

# Optional HTTPS dashboard route through a tunnel on this server.
# Generate the password with: openssl rand -hex 32
# BLYNX_PUBLIC_ORIGIN=https://clips.blynx.vip
# BLYNX_WEB_PASSWORD=YOUR_GENERATED_PASSWORD
