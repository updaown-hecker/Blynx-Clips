# Add or remove channels in the dashboard by default.
# Uncomment only to pin monitoring to one channel via the environment.
# BLYNX_FOLLOW_URL=https://www.twitch.tv/theirname
# Set to 1 to reclaim storage from older, unreviewed automatic highlights.
BLYNX_SERVER_PRUNE=0

# Optional public HTTPS hostname. Manage authentication at your tunnel or reverse proxy.
# BLYNX_PUBLIC_ORIGIN=https://clips.blynx.vip
